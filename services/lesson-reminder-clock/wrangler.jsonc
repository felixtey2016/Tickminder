{
  "name": "tickminder-lesson-reminder-clock",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "vars": {
    "TICKMINDER_ORIGIN": "https://www.tickminder.com"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "account_id": "2199d150c756b2abfd96507da5ff1d8e",
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "DIAGNOSTICS",
      "bucket_name": "tickminder-diagnostics"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
