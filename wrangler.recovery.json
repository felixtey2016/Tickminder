{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tickminder-staging",
  "account_id": "6a436390d3f306fc5c163952bba080ff",
  "main": "worker-entry.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tickminder-staging-db",
      "database_id": "3e49d57b-7f11-4eae-84aa-69d47fef258f",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "tickminder-qa-files"
    },
    {
      "binding": "TICKGAME_ASSETS",
      "bucket_name": "tickminder-qa-game-assets"
    },
    {
      "binding": "DIAGNOSTICS",
      "bucket_name": "tickminder-qa-diagnostics"
    }
  ],
  "vars": {
    "PDF_MAX_BYTES": "10485760",
    "PDF_TOTAL_STORAGE_LIMIT_BYTES": "1073741824",
    "ADMIN_PERMISSIONS_MODE": "enforced",
    "WATCH_PREVIEW_APP_ORIGIN": "https://tickminder-staging.tickminder-qa-ngedu.workers.dev",
    "WATCH_PREVIEW_APP_ALIASES": "https://tickminder-staging-alt.tickminder-qa-ngedu.workers.dev",
    "WATCH_PREVIEW_ORIGIN": "https://tickplay-staging.tickminder-qa-ngedu.workers.dev",
    "GOOGLE_CLIENT_ID": "243216576516-0urb3bjvshr14oj1jg67eqfq766vlctd.apps.googleusercontent.com"
  },
  "triggers": {
    "crons": []
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
